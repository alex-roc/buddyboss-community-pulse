#. Plugin Name of the plugin
#: community-pulse.php
msgid "Community Pulse for BuddyBoss"
msgstr "Community Pulse para BuddyBoss"

#. Description of the plugin
#: community-pulse.php
msgid "Privacy-conscious monthly participation reports for public community activity."
msgstr "Informes mensuales de participación pública en la comunidad, con cuidado de la privacidad."

#. Author of the plugin
#: community-pulse.php
msgid "Alex Ojeda Copa"
msgstr "Alex Ojeda Copa"

#. Author URI of the plugin
#: community-pulse.php
msgid "https://github.com/alex-roc"
msgstr "https://github.com/alex-roc"

#: includes/class-admin.php:114
#: includes/class-plugin.php:47
msgid "View report"
msgstr "Ver informe"

#: includes/class-plugin.php:54
msgid "You cannot access this report."
msgstr "No tienes permiso para ver este informe."

#: includes/class-admin.php:120
msgid "Monthly public participation. Months are UTC calendar months. Only aggregate counts are shown."
msgstr "Participación pública mensual. Los meses son meses calendario en UTC. Solo se muestran conteos agregados."

#: includes/class-admin.php:109
#: includes/class-admin.php:208
#: includes/class-admin.php:261
#: includes/class-public.php:95
msgid "Month"
msgstr "Mes"

#: includes/class-admin.php:129
msgid "This month is still in progress: counts are partial and will grow until the month ends (UTC)."
msgstr "Este mes aún no termina: los conteos son parciales y seguirán creciendo hasta fin de mes (UTC)."

#: includes/class-admin.php:52
msgid "Unique contributors"
msgstr "Participantes únicos"

#: includes/class-admin.php:52
msgid "People who posted at least one public update."
msgstr "Personas que publicaron al menos una actualización pública."

#: includes/class-admin.php:53
#: includes/class-public.php:96
msgid "Public updates"
msgstr "Actualizaciones públicas"

#: includes/class-admin.php:53
msgid "Public activity updates posted (comments not included)."
msgstr "Actualizaciones de actividad públicas (sin contar comentarios)."

#: includes/class-admin.php:54
msgid "Contributors on 2+ days"
msgstr "Participantes en 2 días o más"

#: includes/class-admin.php:36
#: includes/class-public.php:27
msgid "Hidden"
msgstr "Oculto"

#: includes/class-admin.php:156
#: includes/class-public.php:76
msgid "Group"
msgstr "Grupo"

#: includes/class-admin.php:156
msgid "Contributors"
msgstr "Participantes"

#: includes/class-admin.php:156
#: includes/class-public.php:77
msgid "Updates"
msgstr "Actualizaciones"

#: includes/class-admin.php:161
msgid "Group rows overlap: one person can post in several groups, so do not add them up to get unique contributors."
msgstr "Las filas de grupos se superponen: una persona puede publicar en varios grupos, así que no las sumes para obtener participantes únicos."

#: includes/class-admin.php:164
msgid "Only the first 100 qualifying groups are shown."
msgstr "Solo se muestran los primeros 100 grupos que cumplen el criterio."

#: includes/class-admin.php:168
msgid "Download aggregate CSV"
msgstr "Descargar CSV agregado"

#: includes/class-admin.php:183
msgid "What is counted"
msgstr "Qué se cuenta"

#: includes/class-admin.php:185
msgid "Counted: public activity updates on profiles and in public groups."
msgstr "Se cuenta: actualizaciones de actividad públicas en perfiles y en grupos públicos."

#: includes/class-admin.php:186
msgid "Not counted: comments, private or hidden groups, hidden or spam activity, scheduled or non-public posts, messages, reads and logins."
msgstr "No se cuenta: comentarios, grupos privados u ocultos, actividad oculta o spam, publicaciones programadas o no públicas, mensajes, lecturas ni inicios de sesión."

#: includes/class-admin.php:190
msgid "These counts describe public posting, not readers, impact or quality of participation."
msgstr "Estos conteos describen publicaciones públicas, no lectores, impacto ni calidad de la participación."

#. translators: 1: platform name, 2: window start, 3: window end.
#: includes/class-admin.php:177
#, php-format
msgid "Source: %1$s · window %2$s to %3$s UTC (end excluded)."
msgstr "Fuente: %1$s · ventana del %2$s al %3$s UTC (sin incluir el final)."

#: includes/class-admin.php:41
msgid "Select one of the latest 12 UTC calendar months."
msgstr "Elige uno de los últimos 12 meses calendario (UTC)."

#: includes/class-admin.php:44
msgid "Activate BuddyBoss Platform or BuddyPress with the Activity and Groups components."
msgstr "Activa BuddyBoss Platform o BuddyPress con los componentes Actividad y Grupos."

#: includes/class-admin.php:46
msgid "Could not read community activity. Check that BuddyBoss Platform or BuddyPress is up to date."
msgstr "No se pudo leer la actividad de la comunidad. Comprueba que BuddyBoss Platform o BuddyPress estén actualizados."

#: includes/class-admin.php:54
msgid "People who posted on at least two different UTC dates."
msgstr "Personas que publicaron en al menos dos fechas UTC distintas."

#: includes/class-admin.php:55
msgid "Retained from previous month"
msgstr "Continúan del mes anterior"

#: includes/class-admin.php:55
msgid "People who posted this month and also the month before."
msgstr "Personas que publicaron este mes y también el mes anterior."

#: includes/class-admin.php:56
msgid "First-time contributors"
msgstr "Participantes por primera vez"

#: includes/class-admin.php:56
msgid "People whose first public update in the community was this month."
msgstr "Personas cuya primera actualización pública en la comunidad fue este mes."

#: includes/class-admin.php:66
msgid "Monthly report"
msgstr "Informe mensual"

#: includes/class-admin.php:66
msgid "12-month trend"
msgstr "Tendencia de 12 meses"

#: includes/class-admin.php:66
msgid "Public reports"
msgstr "Informes públicos"

#: includes/class-admin.php:99
msgid "Report published. Pages using the shortcode now show it."
msgstr "Informe publicado. Las páginas con el shortcode ya lo muestran."

#: includes/class-admin.php:100
msgid "Report unpublished. It no longer appears on public pages."
msgstr "Informe retirado. Ya no aparece en las páginas públicas."

#: includes/class-admin.php:101
msgid "The report could not be published. Only finished months can be published."
msgstr "No se pudo publicar el informe. Solo se pueden publicar meses terminados."

#. translators: %s: month, YYYY-MM.
#: includes/class-admin.php:134
#, php-format
msgid "Participation in %s"
msgstr "Participación en %s"

#. translators: %d: privacy threshold.
#: includes/class-admin.php:138
#, php-format
msgid "Summary hidden: fewer than %d people posted public updates this month."
msgstr "Resumen oculto: menos de %d personas publicaron actualizaciones públicas este mes."

#. translators: %d: privacy threshold.
#: includes/class-admin.php:147
#: includes/class-admin.php:223
#, php-format
msgid "\"Hidden\" means the figure, or the people it leaves out, is under %d."
msgstr "«Oculto» significa que la cifra, o las personas que deja fuera, son menos de %d."

#. translators: %d: privacy threshold.
#: includes/class-admin.php:152
#, php-format
msgid "Public groups with %d+ contributors"
msgstr "Grupos públicos con %d participantes o más"

#: includes/class-admin.php:154
msgid "No public group reached the threshold this month."
msgstr "Ningún grupo público llegó al umbral este mes."

#: includes/class-admin.php:169
#: includes/class-admin.php:226
msgid "Print or save as PDF"
msgstr "Imprimir o guardar como PDF"

#: includes/class-admin.php:171
msgid "Publish this month…"
msgstr "Publicar este mes…"

#. translators: %1$d: privacy threshold.
#: includes/class-admin.php:188
#, php-format
msgid "Any figure based on fewer than %1$d people, or that would reveal fewer than %1$d people by subtraction, is hidden. This reduces exposure but is not an anonymity guarantee."
msgstr "Se oculta toda cifra basada en menos de %1$d personas, o que por resta revelaría a menos de %1$d personas. Esto reduce la exposición, pero no garantiza el anonimato."

#: includes/class-admin.php:189
msgid "Data is read on demand: nothing is stored unless you publish a report, and nothing is sent to external services."
msgstr "Los datos se leen al momento: no se guarda nada salvo que publiques un informe, y nada se envía a servicios externos."

#: includes/class-admin.php:198
msgid "The last 12 UTC calendar months, oldest first. The current month is still in progress."
msgstr "Los últimos 12 meses calendario (UTC), del más antiguo al más reciente. El mes en curso aún no termina."

#: includes/class-admin.php:205
msgid "Unique contributors per month"
msgstr "Participantes únicos por mes"

#: includes/class-admin.php:214
msgid "in progress"
msgstr "en curso"

#: includes/class-admin.php:225
msgid "Download 12-month CSV"
msgstr "Descargar CSV de 12 meses"

#: includes/class-admin.php:237
msgid "Unique contributors per month; the table below has the exact figures."
msgstr "Participantes únicos por mes; la tabla de abajo tiene las cifras exactas."

#: includes/class-admin.php:244
msgid "hidden"
msgstr "oculto"

#: includes/class-admin.php:258
msgid "Publish a finished month to show it on any page with a shortcode, for example in an annual report or a page for funders. Published reports are frozen copies of the protected figures: visitors never query live activity, and the numbers do not change until you update or unpublish them."
msgstr "Publica un mes terminado para mostrarlo en cualquier página con un shortcode, por ejemplo en un informe anual o una página para donantes. Los informes publicados son copias congeladas de las cifras protegidas: los visitantes nunca consultan la actividad en vivo y los números no cambian hasta que los actualices o retires."

#: includes/class-admin.php:261
msgid "Status"
msgstr "Estado"

#: includes/class-admin.php:261
msgid "Actions"
msgstr "Acciones"

